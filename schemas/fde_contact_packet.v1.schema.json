{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nexus-ai-2045/fractal-decision-ecosystem/blob/main/schemas/fde_contact_packet.v1.schema.json",
  "title": "FDE AI contact packet v1",
  "description": "Judgment-only contact packet. Transport adapters remain unapproved.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "actor",
    "peer",
    "purpose",
    "identity",
    "consent",
    "data_boundary",
    "safety",
    "closure"
  ],
  "properties": {
    "schema_version": { "const": "fde.contact_packet.v1" },
    "packet_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "peer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": ".*\\S.*"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_method", "verification_evidence"],
      "properties": {
        "verification_method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": ".*\\S.*"
        },
        "verification_evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]*$"
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consent_scope", "expiry", "revocation"],
      "properties": {
        "consent_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": ".*\\S.*"
        },
        "expiry": { "type": "string", "format": "date-time" },
        "revocation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": ".*\\S.*"
        }
      }
    },
    "data_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensitivity",
        "recipient_class",
        "allowed_fields",
        "redaction_required",
        "ttl",
        "checksum",
        "human_approved_at",
        "no_raw_source_pointer"
      ],
      "properties": {
        "sensitivity": {
          "enum": ["public", "internal", "private", "secret"]
        },
        "recipient_class": {
          "enum": ["self", "trusted_peer", "unverified_peer", "external_service"]
        },
        "allowed_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "redaction_required": { "type": "boolean" },
        "ttl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": ".*\\S.*"
        },
        "checksum": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "human_approved_at": { "type": "string", "format": "date-time" },
        "no_raw_source_pointer": { "const": true }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocklist", "replay_protection", "transport_adapter_status"],
      "properties": {
        "blocklist": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "replay_protection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": ".*\\S.*"
        },
        "transport_adapter_status": { "const": "unapproved" }
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "next_contact_allowed", "evidence_pointer"],
      "properties": {
        "decision": {
          "enum": ["blocked", "hold", "review_ready", "reject"]
        },
        "next_contact_allowed": { "const": false },
        "evidence_pointer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]*$"
        }
      }
    }
  }
}
